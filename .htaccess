# ====================================================================
# Hostinger Apache / LiteSpeed Security & Fullstack Node.js Routing
# ====================================================================

# 1. HARDEN SECURITY: Block direct HTTP access to Database, Backend Code, & Secrets
RedirectMatch 404 ^/(data|backend|\.env|ecosystem\.config\.cjs|package\.json)(/|$)

<FilesMatch "\.(db|db-wal|db-shm|sqlite|env|sql|md)$">
  Require all denied
</FilesMatch>

# 2. SPA CLIENT ROUTING
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. API REQUESTS: Proxy to Node.js backend (port 3000) if Apache proxy module is enabled
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # Prevent rewriting /api/* to index.html
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 3. Allow direct access to existing physical static files (e.g., in dist/assets)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all remaining frontend page requests to the index.html SPA
  RewriteRule ^ dist/index.html [L]
</IfModule>
