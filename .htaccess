# Hostinger Apache / LiteSpeed Configuration for Fullstack Node.js App
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing physical static files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to the index.html SPA
  RewriteRule ^ dist/index.html [L]
</IfModule>
