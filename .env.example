# ====================================================================
# Business Management & Accountant Management App (Version 1.0)
# Production Environment Configuration
# ====================================================================

PORT=5000
NODE_ENV=production

# JWT / HMAC Session Secret
JWT_SECRET=production-secret-key-change-this-in-live-deployment-2026

# ====================================================================
# AUTHORITATIVE CLOUD DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ====================================================================
# The application uses Supabase PostgreSQL as the authoritative production
# database, with local SQLite acting as resilient offline cache & sync queue.
#
# IMPORTANT SECURITY RULES:
# 1. SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to frontend/browser code.
# 2. Never commit .env or service-role keys to source control.
# 3. Apply backend/db/supabase_schema.sql in your Supabase SQL Editor.

# Provider Selection:
CLOUD_BACKUP_PROVIDER=supabase

# Supabase REST API Configuration:
# Your project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Your secret service-role key (bypasses RLS for authoritative server queries):
# WARNING: Keep on server only. NEVER prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fallback/Alternative Cloud Providers (optional):
# Firebase:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_API_KEY=your-firebase-api-key

# Turso / LibSQL:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
