# ====================================================================
# Business Management & Accountant Management App (Version 1.0)
# Hostinger MySQL & Production Environment Configuration
# ====================================================================

PORT=5000
NODE_ENV=production

# JWT / HMAC Session Secret
JWT_SECRET=production-secret-key-change-this-in-live-deployment-2026

# Backend CORS Origin Configuration
# Allowed origins for browser API requests (comma-separated or '*' for all)
CORS_ORIGIN=*

# Company Master Gateway Credentials (Terminal Administration)
COMPANY_MASTER_KEY=your_company_master_key_here
COMPANY_MASTER_EMAIL=admin@yourbusiness.com
COMPANY_MASTER_PASSWORD=your_secure_master_password_here

# ====================================================================
# HOSTINGER MYSQL DATABASE CONFIGURATION (AUTHORITATIVE SOURCE OF TRUTH)
# ====================================================================
# When deploying on Hostinger (hPanel / VPS / Cloud Hosting):
# 1. In Hostinger hPanel -> Databases -> MySQL Databases:
#    - Create a new MySQL Database (e.g. u123456789_saree_db)
#    - Create a MySQL Username (e.g. u123456789_admin) and set a secure password
#    - Grant ALL PRIVILEGES to the user for that database
# 2. Hostinger internal MySQL server runs on 127.0.0.1:3306 (or localhost:3306)
# 3. Import backend/db/mysql_schema.sql in phpMyAdmin, or allow server.js to auto-run on boot
# 4. Fill in your Hostinger MySQL credentials below:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_your_db_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=u123456789_your_database_name

# Note: The system also automatically recognizes aliases:
# MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE / MYSQL_DB,
# or full connection strings: DATABASE_URL / MYSQL_URL (mysql://user:pass@host:port/db)

# Connection pool configuration (optional):
# DB_CONNECTION_LIMIT=10

# ====================================================================
# FRONTEND VITE CONFIGURATION (Optional)
# ====================================================================
# If frontend is built and served statically by the Node.js Express server
# (the default setup), leave VITE_API_URL empty so requests use relative /api/*.
# Only set VITE_API_URL if the frontend is hosted on a completely separate domain/CDN.
# Example: VITE_API_URL=https://your-domain.com
VITE_API_URL=
