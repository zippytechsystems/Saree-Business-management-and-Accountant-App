# ====================================================================
# Business Management & Accountant Management App (Version 1.0)
# Production Environment Configuration — Hostinger
# ====================================================================

PORT=5000
NODE_ENV=production

# JWT / HMAC Session Secret (Change in production!)
JWT_SECRET=production-secret-key-change-this-in-live-deployment-2026

# Backend CORS Origin Configuration
CORS_ORIGIN=*

# ====================================================================
# HOSTINGER MYSQL DATABASE CONFIGURATION (PRIMARY ENGINE)
# ====================================================================
# When configured, the backend runs natively on Hostinger MySQL (InnoDB).
# If not configured, it operates gracefully on persistent SQLite (data/app.db).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_saree_erp
DB_USER=u123456789_saree_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# ====================================================================
# FRONTEND VITE ENVIRONMENT VARIABLES
# ====================================================================
# For Hostinger 100% native deployment, leave empty (same origin /api).
VITE_API_URL=
